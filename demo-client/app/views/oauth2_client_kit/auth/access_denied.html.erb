<div class="card" style="border-top: 4px solid #f59e0b; max-width: 760px; margin: 1rem auto 2rem;">
  <div style="display: flex; align-items: flex-start; gap: 1.25rem; margin-bottom: 1.5rem;">
    <div style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.5rem;">
      🔒
    </div>
    <div style="flex: 1;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;">
        <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text, #f8fafc); margin: 0; letter-spacing: -0.02em;">Access Denied</h1>
        <span style="display: inline-block; background: rgba(245, 158, 11, 0.18); border: 1px solid rgba(245, 158, 11, 0.35); color: #fde68a; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 9999px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;">
          <%= @error || "access_denied" %>
        </span>
      </div>
      <div style="margin-top: 0.4rem;">
        <span style="display: inline-block; background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.25); color: #38bdf8; font-size: 0.7rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.05em;">
          Demo Client Custom Error View Override
        </span>
      </div>
    </div>
  </div>

  <p style="color: var(--text-muted, #cbd5e1); font-size: 0.95rem; margin-top: 0; margin-bottom: 1.25rem; line-height: 1.6;">
    Your sign-in request could not be completed because permissions were denied or the user account was locked.
  </p>

  <div style="background: var(--code-bg, #090d16); border: 1px solid var(--border, #334155); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.75rem;">
    <span style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #64748b); margin-bottom: 0.35rem;">Status Details</span>
    <div style="color: #fde68a; font-size: 0.925rem; line-height: 1.55; font-weight: 500;">
      <%= @error_description.presence || "The authorization request was rejected or the account is locked." %>
    </div>

    <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border, #334155); font-size: 0.825rem; color: var(--text-muted, #94a3b8); line-height: 1.5;">
      💡 If your account is suspended or locked, please contact your security administrator or helpdesk.
    </div>
  </div>

  <div class="btn-group" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
    <%= button_to auth_start_path, method: :post, class: "btn" do %>
      🔐 Retry Sign In
    <% end %>

    <a href="/" class="btn btn-outline">
      Return to Home
    </a>
  </div>
</div>
