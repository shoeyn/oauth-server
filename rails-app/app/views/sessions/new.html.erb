<div class="card">
  <h2>Sign In (Ruby on Rails)</h2>
  <div class="badge">Connected to Shared Redis & Spring Security</div>

  <%= form_with url: "/login", method: :post, local: true do |f| %>
    <%= f.hidden_field :return_to, value: @return_to %>

    <div style="margin-bottom: 1.25rem;">
      <%= f.label :username, "Username", style: "display: block; font-size: 0.875rem; font-weight: 500; color: #374151; margin-bottom: 0.25rem;" %>
      <%= f.text_field :username, value: "demo_user", required: true, autofocus: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box; font-size: 1rem;" %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :password, "Password", style: "display: block; font-size: 0.875rem; font-weight: 500; color: #374151; margin-bottom: 0.25rem;" %>
      <%= f.password_field :password, value: "password", required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box; font-size: 1rem;" %>
    </div>

    <button type="submit" style="width: 100%; background-color: #4f46e5; color: white; padding: 0.75rem; border: none; border-radius: 6px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;">
      Authorize & Return to OAuth Server
    </button>

    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid #e5e7eb;">
      <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; margin-bottom: 0.75rem; text-align: center;">
        Simulate Authentication Errors
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.6rem;">
        <button type="submit" name="simulate_error" value="access_denied" style="width: 100%; background-color: #d97706; color: white; padding: 0.65rem 0.75rem; font-size: 0.875rem; font-weight: 600; border-radius: 6px; border: none; cursor: pointer; text-align: center; transition: background-color 0.2s;">
          🔒 Simulate Account Locked (Client View Override)
        </button>
        <button type="submit" name="simulate_error" value="account_suspended" style="width: 100%; background-color: #dc2626; color: white; padding: 0.65rem 0.75rem; font-size: 0.875rem; font-weight: 600; border-radius: 6px; border: none; cursor: pointer; text-align: center; transition: background-color 0.2s;">
          ⛔ Simulate Account Suspended (Library Default View)
        </button>
      </div>
    </div>
  <% end %>

  <div class="info-box" style="margin-top: 1.5rem; padding: 0.75rem; background-color: #f9fafb; border-left: 4px solid #4f46e5; font-size: 0.8125rem; color: #4b5563; word-break: break-all;">
    <strong>Flow Info:</strong> Authenticating here writes user attributes into Redis key <code>session:&lt;uuid&gt;</code> and sets a shared cookie. You will be redirected back to the Spring OAuth 2.1 server at:<br>
    <code style="background: #f3f4f6; padding: 0.2rem 0.4rem; border-radius: 4px; display: inline-block; margin-top: 0.25rem;"><%= @return_to %></code>
  </div>
</div>
